# ══════════════════════════════════════════════════════════════
#  Hari Pushp PG Mobile — Environment Variables (EXAMPLE)
#  Copy to .env (dev) or .env.production (prod) and fill in.
# ══════════════════════════════════════════════════════════════

# Development: leave blank, config.js auto-detects via Metro
# Production APK: set to your VPS public IP or domain
# Examples:
#   http://103.x.x.x:9000/api/v1
#   https://api.haripushppg.com/api/v1
EXPO_PUBLIC_API_URL=

# Your LAN IP for local dev fallback
EXPO_PUBLIC_LOCAL_IP=192.168.1.78

# Backend port
EXPO_PUBLIC_API_PORT=9000
