# ══════════════════════════════════════════════════════════════
#  Hari Pushp PG — Backend Environment Variables (EXAMPLE)
#  Copy this file to .env and fill in all REQUIRED values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development                # "development" | "production"
PORT=9000

# ─── Database (PostgreSQL) ────────────────────────────────────
# Local dev example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/hms_dev?schema=public"
#
# Hostinger VPS production (port 5433):
# DATABASE_URL="postgresql://hari_pushp_pg_user:YOUR_PASS@127.0.0.1:5433/hari_pushp_pg?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"

# ─── Auth ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_64_char_secret_here

# ─── Firebase Admin SDK ───────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated, no trailing slash
# Dev:  http://localhost:5173,http://localhost:8081
# Prod: https://yourdomain.com,http://YOUR_VPS_IP
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8081

# ─── SMTP Email (optional) ───────────────────────────────────
# Leave blank to use simulated console email logging
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Mobile API URL ──────────────────────────────────────────
# Public URL of the backend for mobile builds
# e.g. http://YOUR_VPS_IP:9000  or  https://api.yourdomain.com
MOBILE_API_URL=
