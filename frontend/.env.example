# Development (local backend):
# VITE_API_URL=http://localhost:9000/api/v1

# Production (VPS public IP or domain):
# VITE_API_URL=http://YOUR_VPS_IP:9000/api/v1
# VITE_API_URL=https://api.haripushppg.com/api/v1

VITE_API_URL=http://localhost:9000/api/v1
